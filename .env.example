# OpenAI: embeddings + chat completions for drafts
OPENAI_API_KEY=

# Optional: restrict HTTP API (recommended on Railway)
API_TOKEN=

# Persist DB + WhatsApp session on one folder (recommended on Railway with a volume)
# DATA_ROOT=/data

# SQLite path (default: $DATA_ROOT/app.db or ./app.db when DATA_ROOT is .)
DATABASE_PATH=

# Model names
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Port for web API + dashboard
PORT=3000

# Puppeteer: leave unset locally; set on Railway/Linux if needed
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
