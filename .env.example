# OpenRouter: https://openrouter.ai/keys — used for chat completions and embeddings (native fetch, no OpenAI SDK)
OPENROUTER_API_KEY=

# Optional: override API base (default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=

# Optional headers OpenRouter recommends for rankings (defaults are fine for self-hosted)
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=WhatsApp CRM

# Required on Railway (detected via RAILWAY_* env). Protects API + WhatsApp QR in the web UI.
API_TOKEN=

# Only for local/dev: set to 1 to allow API without API_TOKEN (never on a public URL)
# ALLOW_OPEN_API=

# Persist DB + WhatsApp session on one folder (recommended on Railway with a volume)
# DATA_ROOT=/data

# SQLite path (default: $DATA_ROOT/app.db or ./app.db when DATA_ROOT is .)
DATABASE_PATH=

# OpenRouter model ids (see https://openrouter.ai/models)
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Port for web API + dashboard
PORT=3000

# Puppeteer: leave unset locally; set on Railway/Linux if needed
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
